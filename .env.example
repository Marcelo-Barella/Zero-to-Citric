# =============================================================================
# Zero To Citric - Environment Variables
# =============================================================================
# Copy to .env.local for the bot, or to apps/voice-worker/.env for the worker.

# ----- Core (shared) -----
NODE_ENV=development
LOG_LEVEL=info
BOT_LOCALE=pt-BR
APP_VERSION=dev

# ----- Discord (Chat SDK adapter + worker) -----
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_MENTION_ROLE_IDS=

# ----- LLM (AI Gateway) -----
AI_GATEWAY_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.6
EMBEDDING_MODEL=openai/text-embedding-3-small

# ----- Memory -----
MEMORY_ENABLED=false
MAX_RETRIEVAL_RESULTS=10
MEMORY_SIMILARITY_THRESHOLD=0.6
MEMORY_RETENTION_DAYS=30
POSTGRES_URL=
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Web search -----
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

# ----- Music (worker) -----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MAX_QUEUE_SIZE=50

# ----- TTS / STT (worker) -----
TTS_PROVIDER=elevenlabs
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
PIPER_SIDECAR_URL=http://piper:9001
WHISPER_PROVIDER=zhipu
WHISPER_SIDECAR_URL=http://whisper:9000
OPENAI_API_KEY=
ZHIPU_API_KEY=

# ----- Wake word -----
WAKE_WORD=tangerina
WAKE_WINDOW_MS=5000
WAKE_DUCK_VOLUME=20

# ----- Integrations -----
N8N_WEBHOOK_URL=

# ----- Voice worker auth -----
WORKER_BASE_URL=
WORKER_SHARED_SECRET=

# ----- Public REST API -----
API_KEY=
LEGACY_ROUTES=false
ADMIN_TOKEN=

# ----- Vercel cron / Discord gateway -----
CRON_SECRET=

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=
